{
  "name": "noxfit",
  "version": "1.0.0",
  "description": "Servidor backend con Express y MongoDB Atlas para Noxfit",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "frontend:dev": "npm --prefix frontend run dev --",
    "frontend:build": "npm --prefix frontend run build",
    "test": "node --test",
    "data:workbook": "node scripts/build-workbook.js",
    "check": "node --check src/server.js && node --check src/app.js && node --check scripts/seed.js && node --check scripts/check-openapi.js && node -e \"require('./src/app'); require('./src/server'); require('./scripts/seed')\"",
    "seed": "node scripts/seed.js",
    "openapi:check": "node scripts/check-openapi.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sara-manzano/noxfit.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/sara-manzano/noxfit/issues"
  },
  "homepage": "https://github.com/sara-manzano/noxfit#readme",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.0",
    "morgan": "^1.10.1",
    "nodemailer": "^10.2.1",
    "swagger-ui-express": "^5.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}
